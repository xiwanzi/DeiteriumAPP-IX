# Include inside the http context. Replace host, certificates and static root.
map $http_upgrade $deuterium_connection {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name community.example.invalid;
    ssl_certificate /etc/letsencrypt/live/REPLACE/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE/privkey.pem;
    root /var/www/deuterium/current/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $deuterium_connection;
        proxy_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 1m;
    }
    location /bridge/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $deuterium_connection;
        proxy_read_timeout 70s;
    }
    location /downloads/ {
        alias /var/www/deuterium/downloads/;
        autoindex off;
    }
    location = /web-config.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
