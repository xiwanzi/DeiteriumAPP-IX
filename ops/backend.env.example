# Copy to a protected path; never commit real values.
DEUTERIUM_DSN='REPLACE_USER:REPLACE_PASSWORD@tcp(127.0.0.1:3306)/deuterium_backend'
DEUTERIUM_RELEASE_MANIFEST=/etc/deuterium/releases.json
DEUTERIUM_AI_CONFIG_FILE=/etc/deuterium/ai-config.json
DEUTERIUM_AI_PROMPT_FILE=/etc/deuterium/ai-prompt.json
DEUTERIUM_S3_ENDPOINT=https://s3.example.invalid
DEUTERIUM_S3_REGION=REPLACE_REGION
DEUTERIUM_S3_BUCKET=REPLACE_BUCKET
DEUTERIUM_S3_PREFIX=deuterium-test/
DEUTERIUM_S3_ACCESS_KEY=REPLACE_ACCESS_KEY
DEUTERIUM_S3_SECRET_KEY=REPLACE_SECRET_KEY
DEUTERIUM_ASSET_GC_ENABLED=false
