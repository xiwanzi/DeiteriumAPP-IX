limit_req_zone $binary_remote_addr zone=deuterium_admission_public:2m rate=30r/m;

server {
    listen 9443 ssl;
    server_name 47.103.99.34;
    ssl_certificate /etc/letsencrypt/live/deuterium-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/deuterium-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/deuterium-admission/current;
    index index.html;
    charset utf-8;
    client_max_body_size 8k;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location ^~ /api/v1/admission/ {
        limit_req zone=deuterium_admission_public burst=15 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 16s;
    }
    location /api/ { return 404; }
    location /bridge/ { return 404; }
    location ~ /\. { deny all; }
    location ~ \.(md|json|map|log)$ { return 404; }
    location /assets/ { try_files $uri =404; expires 7d; }
    location / { try_files $uri $uri/ =404; expires -1; }
}

