# Temporary IP entry. Keep the site directory separate until its independent domain is ready.
# Declare this once in the nginx http context:
# limit_req_zone $binary_remote_addr zone=deuterium_admission_public:2m rate=30r/m;

# Add these locations inside the existing HTTPS IP server:
location = /admission { return 308 /admission/; }
location ^~ /admission/ {
    alias /var/www/deuterium-admission/current/;
    index index.html;
    autoindex off;
    expires -1;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
}
location ^~ /api/v1/admission/ {
    limit_req zone=deuterium_admission_public burst=15 nodelay;
    limit_req_status 429;
    client_max_body_size 8k;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_read_timeout 16s;
}
